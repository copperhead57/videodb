{*  Template for IMDB Online browsing  $Id: trace.tpl,v 1.2 2005/05/21 11:48:44 andig2 Exp $*}<!-- {$smarty.template} --><div id="actions">	<h3>URL: </h3><a href="{$url}" target="_blank">{$url}</a>	<nobr>{if $fetchtime}<span class="filterlink">{$lang.fetchtime}: </span>{$fetchtime}s{else}&nbsp;{/if}{if !empty($md5)} {$md5}{/if}</nobr>	<form action="trace.php" method="get">		<input type="hidden" name="videodburl" value="{$url}" />		<input type="hidden" name="videodbreload" value="1" />		<input type="submit" class="button" value="Reload" />	</form></div><div id="content"><style>    html, body {        height: 100%;        margin: 0;    }    /* Make the whole page a vertical flex layout */    #container {        display: flex;        flex-direction: column;        height: 100%;    }    /* Make the content area expand to fill remaining space */    #content {        flex: 1;        display: flex;        flex-direction: column;    }    /* Make the iframe wrapper fill #content */    .fullframe {        flex: 1;    }    /* Make the iframe fill the wrapper */    .fullframe iframe {        width: 100%;        height: 100%;        border: none;    }</style>    <div class="fullframe">        <iframe            id="inlineFrameIMDB"            title="IMDB Browser"            width="100%"            height="100%"            src="trace.php?iframe=2&videodburl={$url}">        </iframe>    </div><script>document.addEventListener("DOMContentLoaded", function () {    const iframe = document.getElementById("inlineFrameIMDB");    // Buttons/fields to update    const openBtn = document.querySelector("#actions a[target='_blank']");    const reloadForm = document.querySelector("#actions form");    const reloadInput = reloadForm.querySelector("input[name='videodburl']");    function updateButtons() {        try {            // Full iframe URL (e.g. trace.php?iframe=2&videodburl=...)            const fullUrl = iframe.contentWindow.location.href;            // Extract ONLY the IMDb URL after videodburl=            const match = fullUrl.match(/videodburl=([^&]+)/);            if (!match) return;            const imdbUrl = decodeURIComponent(match[1]);            // Update Open in Browser button            openBtn.href = imdbUrl;            openBtn.textContent = imdbUrl; // update visible text too            // Update Reload form hidden field            reloadInput.value = imdbUrl;        } catch (e) {            // Cross-origin navigation blocks access until fully loaded            // This is normal for IMDb        }    }    iframe.addEventListener("load", updateButtons);});</script></div>