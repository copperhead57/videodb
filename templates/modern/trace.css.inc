/* ---------------------------------------------------------
   Modern Template – Trace View Overrides
   This file customizes the appearance of the unified baseline
   without duplicating shared logic or layout rules.
---------------------------------------------------------- */

/* Modern table filter styling */
.tablefilter {
    background: #f4f4f4;
    border-bottom: 1px solid #ccc;
    padding: 6px 10px;
    font-size: 14px;
}

.tablefilter .filterlink {
    font-weight: bold;
    color: #333;
}

/* Modern button style */
.button {
    background: #4a90e2;
    color: #fff;
    border: none;
    padding: 6px 12px;
    border-radius: 4px;
    cursor: pointer;
    font-size: 13px;
}

.button:hover {
    background: #357ab8;
}

/* Modern iframe wrapper adjustments */
.fullframe {
    height: 70vh;        /* Modern template uses a shorter viewport */
    background: #fff;
}

/* Spinner override for modern theme */
#iframeSpinner {
    font-size: 20px;
    font-weight: bold;
    color: #333;
    background: rgba(255, 255, 255, 0.85);
}
